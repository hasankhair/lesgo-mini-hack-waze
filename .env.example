# Copy to .env and fill in. Both the API (backend) and the web app (frontend,
# VITE_* variables only) read this file.

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API). Only the PUBLIC anon key is used.
# Never put the service-role key here or in any VITE_* variable.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
PORT=4000
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting).
TRUST_PROXY=0
# Public OSM services require an identifying User-Agent with contact info.
UPSTREAM_USER_AGENT=Lesgo/0.1 (you@example.com)
UPSTREAM_TIMEOUT_MS=10000

# Leave empty in development: Vite proxies /api to http://localhost:4000.
# Set to the API origin when the frontend is hosted separately.
VITE_API_URL=

# ---------------------------------------------------------------------------
# Geocoding: photon (default, supports autocomplete) | nominatim (1 req/s, search on Enter)
# ---------------------------------------------------------------------------
GEOCODING_PROVIDER=photon
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=

# ---------------------------------------------------------------------------
# Routing: osrm (default) | openrouteservice (needs ORS_API_KEY; true shortest + avoid tolls)
# ---------------------------------------------------------------------------
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org
# true only for a self-hosted OSRM that supports exclude=toll (the public demo does not).
OSRM_SUPPORTS_EXCLUDE=false
ORS_URL=https://api.openrouteservice.org
ORS_API_KEY=

# Live traffic data: none (default). See backend/services/traffic/index.js to add one.
TRAFFIC_PROVIDER=none

# ---------------------------------------------------------------------------
# Map tiles (frontend). Defaults: OSM standard tiles; dark mode = same tiles with a CSS filter.
# ---------------------------------------------------------------------------
VITE_TILE_LIGHT_URL=
VITE_TILE_LIGHT_ATTRIBUTION=
VITE_TILE_DARK_URL=
VITE_TILE_DARK_ATTRIBUTION=
VITE_TILE_DARK_SUBDOMAINS=
# Initial map position before the user shares their location.
VITE_DEFAULT_LAT=51.5074
VITE_DEFAULT_LNG=-0.1278
VITE_DEFAULT_ZOOM=13

# ---------------------------------------------------------------------------
# Rate limits (per IP, or per user for reports/votes)
# ---------------------------------------------------------------------------
RATE_LIMIT_API_PER_15MIN=600
RATE_LIMIT_GEOCODE_PER_MIN=60
RATE_LIMIT_ROUTE_PER_MIN=30
RATE_LIMIT_REPORTS_PER_MIN=5
RATE_LIMIT_VOTES_PER_MIN=30
